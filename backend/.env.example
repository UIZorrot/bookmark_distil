# ---- App / domain ----
PUBLIC_APP_URL=https://tool.bookmark.txzy.net
CORS_ORIGINS=https://tool.bookmark.txzy.net,chrome-extension://YOUR_EXTENSION_ID
API_PREFIX=/api/v1

# Database (root .env may use DB_PATH; either works)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Member JWT (extension stores returned Bearer token only)
MEMBER_JWT_SECRET=replace-with-long-random-string
MEMBER_JWT_ALG=HS256
MEMBER_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Primary LLM (DeepSeek paid path)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Free / degraded path (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL_FREE_PRIMARY=tencent/hy3-preview:free
OPENROUTER_MODEL_FREE_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free

# Email verification code login (Resend)
RESEND_API_KEY=
EMAIL_FROM=Bookmark Distil <no-reply@yourdomain.tld>
EMAIL_CODE_PEPPER=replace-with-random-pepper
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_IP_HOURLY_CAP=8

# Stripe — create two monthly recurring prices: USD $4.88 vs CNY ¥18.88
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_US_MONTHLY=price_USD_4_88_MOCK
STRIPE_PRICE_PRO_CN_MONTHLY=price_CNY_18_88_MOCK

# Hosted-AI rate shaping (per-user, in-process; refine with Redis for HA)
AI_REQUESTS_PER_MINUTE_NORMAL=24
AI_REQUESTS_PER_MINUTE_DEGRADED=6
AI_SHORT_WINDOW_SECONDS=900
AI_SHORT_WINDOW_REQ_THRESHOLD=40
AI_SOFT_DAILY_REQUEST_CAP=220
AI_DEGRADED_COOLDOWN_SECONDS=3600
