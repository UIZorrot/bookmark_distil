# Public extension build-time config. Values prefixed with VITE_ are bundled into the extension.
# Local backend first; switch this to https://tool.bookmark.txzy.net/api/v1 before real remote testing.
VITE_MEMBER_API_BASE=http://127.0.0.1:8789/api/v1

# Backend also loads this root .env, but keep secrets in backend/.env if you prefer
# to avoid mixing extension build-time public values with server-only secrets.
# DATABASE_URL=
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
