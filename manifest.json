{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "options_page": "index.html",
  "permissions": [
    "downloads",
    "tabs",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/sw.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhihu.com/collection/*",
        "https://x.com/i/bookmarks*",
        "https://twitter.com/i/bookmarks*",
        "https://*.xiaohongshu.com/user/profile/*"
      ],
      "js": ["src/content/cs.ts"]
    }
  ]
}
